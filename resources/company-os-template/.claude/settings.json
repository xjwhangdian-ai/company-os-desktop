{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | grep -qE 'rm -rf|knowledge/[^ ]*[ ]*>'; then echo '已拦截：检测到危险删除操作或试图覆写只读资料 knowledge/' >&2; exit 2; fi; exit 0"
          }
        ]
      }
    ]
  }
}
